{
  "name": "comfyui-assistant",
  "version": "0.2.0",
  "description": "ComfyUI assistant for DeepSeek Harness (dsh): inspect the server, preflight API-format workflows before spending GPU time, run them, and show generated images inline as attachments while also saving them into the workspace.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-cordis",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "guided",
      "adapter": "third-party",
      "failurePolicy": "manual",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "hot-reload",
      "dispose": "supported"
    },
    "permissions": [
      "fs:read",
      "fs:write",
      "net:loopback",
      "net:https"
    ],
    "compatibility": {
      "dshVersions": [
        "0.2.1-alpha.3",
        "0.2.1-rc.2"
      ]
    },
    "capability": {
      "id": "comfyui-toolkit",
      "kind": "tools",
      "invocation": "Agent calls comfyui_status / comfyui_validate_workflow / comfyui_run_workflow",
      "expected": "A preflighted workflow runs, the image is saved into the workspace and rendered inline as an attachment."
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "comfyui",
    "stable-diffusion",
    "image-to-image",
    "workflow",
    "ai-generated"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "smoke": "node test/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenjiang2025/ComfyUI-comfyui-assistant.git"
  },
  "homepage": "https://github.com/chenjiang2025/ComfyUI-comfyui-assistant#readme",
  "bugs": {
    "url": "https://github.com/chenjiang2025/ComfyUI-comfyui-assistant/issues"
  }
}
